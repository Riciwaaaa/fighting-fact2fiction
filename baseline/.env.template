# .env.template  —  copy this to .env and fill in your keys
# NEVER commit .env to git (it contains secrets)

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# GLM model ID on OpenRouter — find the exact string at openrouter.ai/models
MODEL_NAME=google/gemini-3.5-flash

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-YOUR_SECRET_KEY
LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_PUBLIC_KEY
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ── Data paths ────────────────────────────────────────────────────────────────
# Relative to baseline/run.py  (or use absolute paths)
AVERITEC_DEV_PATH=../DEFAME/data/AVeriTeC/dev.json