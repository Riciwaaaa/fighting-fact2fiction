{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1_rag_judgment.schema.json",
  "title": "Stage 1 RAG endpoint judgment",
  "type": "object",
  "required": ["verdict", "confidence", "justification", "questions"],
  "properties": {
    "verdict": {
      "enum": ["Supported", "Refuted", "Conflicting Evidence", "Not Enough Evidence"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "justification": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "status", "answer", "selected_rank", "evidence"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "status": {"enum": ["answered", "none", "dropped"]},
          "answer": {"type": ["string", "null"], "minLength": 1},
          "selected_rank": {"type": ["integer", "null"], "minimum": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
